---
interface Props {
  schedule: {
    cycle?: {
      length: {
        value: number;
        unit: string;
      };
    };
    stopCondition: {
      plannedCycles?: number;
    };
  };
}

const { schedule } = Astro.props;

const hasCycle = Boolean(schedule.cycle);
const hasPlannedCycles = Boolean(
  schedule.stopCondition.plannedCycles,
);
---

<section
  class="clinical-card regimen-schedule"
  aria-labelledby="schedule-heading"
>
  <div class="section-heading">
    <h2 id="schedule-heading">Schedule</h2>
    <p>Cycle timing and planned treatment duration.</p>
  </div>

  {
    hasCycle || hasPlannedCycles ? (
      <div class="schedule-grid">

        {
          hasCycle && (
            <div class="schedule-item">
              <span class="schedule-item__label">
                Cycle length
              </span>

              <span class="schedule-item__value">
                {schedule.cycle!.length.value}{" "}
                {schedule.cycle!.length.unit}
              </span>
            </div>
          )
        }

        {
          hasPlannedCycles && (
            <div class="schedule-item">
              <span class="schedule-item__label">
                Planned cycles
              </span>

              <span class="schedule-item__value">
                {schedule.stopCondition.plannedCycles}
              </span>
            </div>
          )
        }

      </div>
    ) : (
      <p class="empty-state">
        No schedule information is currently listed.
      </p>
    )
  }
</section>

<style>
  .regimen-schedule {
    margin-top: 1.25rem;
  }

  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .schedule-item {
    padding: 1rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    background: var(--color-background);
  }

  .schedule-item__label {
    display: block;
    margin-bottom: 0.25rem;

    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .schedule-item__value {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .empty-state {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .schedule-grid {
      grid-template-columns: 1fr;
    }
  }
</style>