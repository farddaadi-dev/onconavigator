# ============================================================================
# Burkitt Lymphoma — High-Risk with Proven CNS Disease
# Dose-Modified R-CODOX-M
# ============================================================================

id: dm-r-codox-m-high-risk-cns

title: DM-R-CODOX-M

description: >
  High-risk dose-modified R-CODOX-M regimen for Burkitt lymphoma
  with proven CNS disease, consisting of rituximab, cyclophosphamide,
  vincristine, doxorubicin, methotrexate, and intensified intrathecal
  therapy.

aliases:
  - High-Risk CNS DM-R-CODOX-M
  - R-CODOX-M

type: standalone

# ----------------------------------------------------------------------------
# Clinical Context
# ----------------------------------------------------------------------------

diseases:
  - burkitt-lymphoma

treatmentIntent:
  - curative

setting:
  - newly-diagnosed

lineOfTherapy:
  - first-line

biomarkers: []

# ----------------------------------------------------------------------------
# Eligibility
# ----------------------------------------------------------------------------

eligibility:
  - Burkitt lymphoma with high-risk disease.
  - Proven CNS disease.
  - Treatment according to the applicable clinical protocol.

# ----------------------------------------------------------------------------
# Schedule
# ----------------------------------------------------------------------------

schedule:
  cycleLength:
    value: 21
    unit: days

  plannedCycles: 2

# ----------------------------------------------------------------------------
# Pre-treatment Assessment
# ----------------------------------------------------------------------------

preTreatmentAssessment:

  diagnosis:
    - Confirm diagnosis of Burkitt lymphoma.
    - Confirm high-risk disease according to applicable clinical criteria.
    - Confirm proven CNS disease.

  clinical:
    - Assess baseline performance status.
    - Assess for clinically significant infection before treatment.
    - Assess baseline neurological status.
    - Assess baseline ocular status before high-dose cytarabine.

  laboratory:
    - Complete blood count (CBC).
    - Renal function.
    - Hepatic function.
    - Serum electrolytes.
    - Serum uric acid.
    - LDH.

  infectionScreening:
    - Screen for hepatitis B infection before rituximab-containing therapy.

  imaging:
    - Perform disease assessment according to the applicable Burkitt lymphoma protocol.
    - Assess CNS disease according to the applicable protocol.

  calculations:
    - Calculate body surface area (BSA).
    - Assess renal function before high-dose methotrexate.

  counselling:
    - Discuss treatment goals and intensive chemotherapy schedule.
    - Discuss CNS-directed intrathecal treatment.
    - Discuss potential treatment-related toxicities.
    - Discuss the need for frequent laboratory monitoring and supportive care.
    - Obtain informed consent.

  other: []

# ----------------------------------------------------------------------------
# Treatment Preparation
# ----------------------------------------------------------------------------

treatmentPreparation:

  premedications:
    - Paracetamol 1000 mg PO 60 minutes before rituximab.
    - Loratadine 10 mg PO 60 minutes before rituximab.
    - Hydrocortisone 100 mg IV 30 minutes before rituximab.

  antiemetics:
    risk: high
    medications: []

  hydration:
    - Provide protocol-appropriate hydration for high-dose methotrexate.
    - Provide appropriate hydration with cyclophosphamide according to institutional protocol.

  prophylaxis: []

  other: []

# ----------------------------------------------------------------------------
# Medications
# ----------------------------------------------------------------------------

medications:

  # --------------------------------------------------------------------------
  # Rituximab
  # --------------------------------------------------------------------------

  - drug: rituximab

    rules:

      - dose:
          value: 375
          unit: mg/m2
          type: bsa

        administration:
          route: IV
          administrationDays:
            - 1
          volume:
            value: 500
            unit: mL
          diluent: sodium chloride 0.9%
          infusionDuration: graded administration rate

      - dose:
          value: 375
          unit: mg/m2
          type: bsa

        administration:
          route: IV
          administrationDays:
            - 11
          volume:
            value: 500
            unit: mL
          diluent: sodium chloride 0.9%
          infusionDuration: graded administration rate

  # --------------------------------------------------------------------------
  # Doxorubicin
  # --------------------------------------------------------------------------

  - drug: doxorubicin

    rules:

      - dose:
          value: 40
          unit: mg/m2
          type: bsa

        administration:
          route: IV
          administrationDays:
            - 1
          infusionDuration: 5 to 15 minutes

  # --------------------------------------------------------------------------
  # Vincristine
  # --------------------------------------------------------------------------

  - drug: vincristine

    rules:

      - dose:
          value: 1.5
          unit: mg/m2
          type: bsa

        administration:
          route: IV
          administrationDays:
            - 1
            - 8
          volume:
            value: 50
            unit: mL
          diluent: sodium chloride 0.9%
          infusionDuration: 5 to 10 minutes
          notes: Cap dose at 2 mg; administer via minibag.

  # --------------------------------------------------------------------------
  # Cyclophosphamide
  # --------------------------------------------------------------------------

  - drug: cyclophosphamide

    rules:

      - dose:
          value: 800
          unit: mg/m2
          type: bsa

        administration:
          route: IV
          administrationDays:
            - 1
          volume:
            value: 500
            unit: mL
          diluent: sodium chloride 0.9%
          infusionDuration: 30 to 60 minutes

      - dose:
          value: 200
          unit: mg/m2
          type: bsa

        administration:
          route: IV
          administrationDays:
            - 2
            - 3
            - 4
            - 5
          volume:
            value: 500
            unit: mL
          diluent: sodium chloride 0.9%
          infusionDuration: 30 to 60 minutes

  # --------------------------------------------------------------------------
  # Cytarabine — Intrathecal
  # --------------------------------------------------------------------------

  - drug: cytarabine

    rules:

      - dose:
          value: 70
          unit: mg
          type: flat

        administration:
          route: IT
          administrationDays:
            - 1
            - 3
            - 5
          notes: Adhere to local institutional intrathecal policy.

  # --------------------------------------------------------------------------
  # Methotrexate — High Dose IV
  # --------------------------------------------------------------------------

  - drug: methotrexate

    rules:

      - dose:
          value: 300
          unit: mg/m2
          type: bsa

        administration:
          route: IV
          administrationDays:
            - 10
          volume:
            value: 500
            unit: mL
          diluent: sodium chloride 0.9%
          infusionDuration: 60 minutes

      - dose:
          value: 2700
          unit: mg/m2
          type: bsa

        administration:
          route: IV
          administrationDays:
            - 10
          volume:
            value: 1000
            unit: mL
          diluent: sodium chloride 0.9%
          infusionDuration: 23 hours

      # ----------------------------------------------------------------------
      # Methotrexate — Intrathecal
      # ----------------------------------------------------------------------

      - dose:
          value: 12
          unit: mg
          type: flat

        administration:
          route: IT
          administrationDays:
            - 15
            - 17
          notes: Adhere to local institutional intrathecal policy.

  # --------------------------------------------------------------------------
  # Leucovorin
  # --------------------------------------------------------------------------

  - drug: leucovorin

    rules:

      - dose:
          value: 15
          unit: mg/m2
          type: bsa

        administration:
          route: IV
          administrationDays:
            - 11
          notes: >
            Start 36 hours after commencement of methotrexate infusion.
            Repeat every 3 hours for the next 12 hours, then every 6 hours
            until methotrexate level is less than 0.1 micromol/L.

      - dose:
          value: 15
          unit: mg
          type: flat

        administration:
          route: PO
          administrationDays:
            - 16
          notes: Once only, 24 hours after intrathecal methotrexate.

      - dose:
          value: 15
          unit: mg
          type: flat

        administration:
          route: PO
          administrationDays:
            - 18
          notes: Once only, 24 hours after intrathecal methotrexate.

  # --------------------------------------------------------------------------
  # Filgrastim
  # --------------------------------------------------------------------------

  - drug: filgrastim

    rules:

      - dose:
          value: 5
          unit: micrograms/kg
          type: weight

        administration:
          route: SC
          administrationDays:
            - 13
          notes: >
            Administer once daily starting on day 13 and continue until
            ANC is greater than 1.0 x 10^9/L.

# ----------------------------------------------------------------------------
# Supportive Care
# ----------------------------------------------------------------------------

supportiveCare:
  - g-csf-support
  - tumor-lysis-syndrome
  - febrile-neutropenia

# ----------------------------------------------------------------------------
# Monitoring
# ----------------------------------------------------------------------------

monitoring:

  beforeEachCycle:
    - Complete blood count.
    - Renal function.
    - Hepatic function.
    - Assess treatment-related toxicities.
    - Confirm unsupported ANC is greater than 1.0 x 10^9/L.
    - Confirm unsupported platelet count is greater than 75 x 10^9/L.
    - Assess performance status and clinical fitness for intensive chemotherapy.
    - Assess for signs or symptoms of infection.
    - Assess neurological status.
    - Assess ocular toxicity from previous cytarabine exposure.
    - Confirm CNS disease management according to the applicable protocol.

  duringTreatment:
    - Monitor for rituximab infusion-related reactions.
    - Monitor for myelosuppression and febrile neutropenia.
    - Monitor for vincristine-related peripheral neuropathy.
    - Monitor for cyclophosphamide toxicity and hemorrhagic cystitis.
    - Monitor renal function and fluid balance.
    - Monitor high-dose methotrexate levels and renal clearance.
    - Monitor for methotrexate toxicity.
    - Monitor for complications related to intrathecal chemotherapy.
    - Monitor neurological status.
    - Monitor for mucositis and gastrointestinal toxicity.
    - Monitor for hepatotoxicity.

# ----------------------------------------------------------------------------
# Dose Modifications
# ----------------------------------------------------------------------------

doseModifications:
  - Refer to the applicable protocol for dose modification in patients older than 65 years.
  - Modify treatment according to hematologic and clinically significant organ toxicity.
  - Follow protocol-specific high-dose methotrexate dose modification and leucovorin rescue guidance.
  - Refer to the applicable protocol and product information for drug-specific dose modification guidance.

