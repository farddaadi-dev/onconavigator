---
import { getCollection } from "astro:content";

import {
  getRegimenById,
  getSourceById,
} from "../../utils/content";

export async function getStaticPaths() {
  const diseases = await getCollection("diseases");

  return diseases.map((disease) => ({
    params: { id: disease.data.id },
    props: { disease },
  }));
}

const { disease } = Astro.props;

const firstLineRegimens = (
  await Promise.all(
    disease.data.treatment.firstLine.map((id) => getRegimenById(id)),
  )
).filter((regimen) => regimen !== undefined);

const references = (
  await Promise.all(disease.data.references.map((id) => getSourceById(id)))
).filter((source) => source !== undefined);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{disease.data.title} | OncoNavigator</title>
  </head>
  <body>
    <main>
      <a href="/">OncoNavigator</a>

      <header>
        <h1>{disease.data.title}</h1>
        {disease.data.aliases.length > 0 && (
          <p>{disease.data.aliases.join(", ")}</p>
        )}
      </header>

      <section aria-labelledby="clinical-context-heading">
        <h2 id="clinical-context-heading">Clinical context</h2>
        {disease.data.clinicalContext.category.length > 0 && (
          <p>
            <strong>Category:</strong>
            {" "}{disease.data.clinicalContext.category.join(", ")}
          </p>
        )}
        {disease.data.clinicalContext.behavior.length > 0 && (
          <p>
            <strong>Behavior:</strong>
            {" "}{disease.data.clinicalContext.behavior.join(", ")}
          </p>
        )}
      </section>

      <section aria-labelledby="treatment-heading">
        <h2 id="treatment-heading">First-line treatment</h2>
        {firstLineRegimens.length > 0 ? (
          <ul>
            {firstLineRegimens.map((regimen) => (
              <li>
                <strong>
                  <a href={`/regimens/${regimen.data.id}`}>
                    {regimen.data.title}
                  </a>
                </strong>
                <p>
                  {regimen.data.setting} · {regimen.data.intent} intent
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <p>No first-line regimens are currently listed.</p>
        )}
      </section>

      <section aria-labelledby="references-heading">
        <h2 id="references-heading">References</h2>
        {references.length > 0 ? (
          <ul>
            {references.map((source) => (
              <li>
                <a href={`/sources/${source.data.id}`}>
                  {source.data.title}
                </a>
                <p>{source.data.publication.citation}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p>No references are currently listed.</p>
        )}
      </section>
    </main>
  </body>
</html>
