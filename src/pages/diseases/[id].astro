---
import { getCollection } from "astro:content";
import { getClinicalLabel } from '@/utils/clinicalTerms';
import { formatLabel } from '@/utils/formatText';
import {
  getRegimenById,
  getSourceById,
  getSupportiveCareById,
} from "@/utils/content";

export async function getStaticPaths() {
  const diseases = await getCollection("diseases");

  return diseases.map((disease) => ({
    params: { id: disease.data.id },
    props: { disease },
  }));
}

const { disease } = Astro.props;

const treatmentGroups = await Promise.all(
  disease.data.treatment.map(async (treatment) => {
    const regimens = (
      await Promise.all(
        treatment.regimens.map((id) => getRegimenById(id)),
      )
    ).filter(
      (regimen): regimen is NonNullable<typeof regimen> =>
        regimen !== undefined,
    );

    return {
      setting: treatment.setting,
      lineOfTherapy: treatment.lineOfTherapy,
      regimens,
    };
  }),
);

const categoryGroups = await Promise.all(
  disease.data.categories.map(async (category) => {
    const treatments = await Promise.all(
      category.treatment.map(async (treatment) => {
        const regimens = (
          await Promise.all(
            treatment.regimens.map((id) => getRegimenById(id)),
          )
        ).filter(
          (regimen): regimen is NonNullable<typeof regimen> =>
            regimen !== undefined,
        );

        return {
          setting: treatment.setting,
          lineOfTherapy: treatment.lineOfTherapy,
          regimens,
        };
      }),
    );

    return {
      title: category.title,
      treatments,
    };
  }),
);

const supportiveCareItems = (
  await Promise.all(
    disease.data.supportiveCare.map((id) =>
      getSupportiveCareById(id),
    ),
  )
).filter(
  (item): item is NonNullable<typeof item> =>
    item !== undefined,
);

const references = (
  await Promise.all(
    disease.data.references.map((id) => getSourceById(id)),
  )
).filter(
  (source): source is NonNullable<typeof source> =>
    source !== undefined,
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{disease.data.title} | OncoNavigator</title>
  </head>

  <body>
    <main>
      <a href="/">OncoNavigator</a>

      <header>
        <h1>{disease.data.title}</h1>

        {
          disease.data.aliases.length > 0 && (
            <p>{disease.data.aliases.join(", ")}</p>
          )
        }
      </header>

      {
        categoryGroups.length > 0 && (
          <section aria-labelledby="categories-heading">
            <h2 id="categories-heading">Categories</h2>

            {
              categoryGroups.map((category) => (
                <div>
                  <h3>{category.title}</h3>

                  {
                    category.treatments.map((treatment) => (
                      <div>
                        <h4>{formatLabel(treatment.setting)}</h4>
                        <h5>{formatLabel(treatment.lineOfTherapy)}</h5>

                        {
                          treatment.regimens.length > 0 ? (
                            <ul>
                              {treatment.regimens.map((regimen) => (
                                <li>
                                  <a
                                    href={`/regimens/${regimen.data.id}`}
                                  >
                                    {regimen.data.title}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          ) : (
                            <p>No regimens are currently listed.</p>
                          )
                        }
                      </div>
                    ))
                  }
                </div>
              ))
            }
          </section>
        )
      }

      {
        treatmentGroups.length > 0 && (
          <section aria-labelledby="treatment-heading">
            <h2 id="treatment-heading">Treatment</h2>

            {
              treatmentGroups.map((treatment) => (
                <div>
                  <h3>{formatLabel(treatment.setting)}</h3>
                  <h4>{formatLabel(treatment.lineOfTherapy)}</h4>

                  {
                    treatment.regimens.length > 0 ? (
                      <ul>
                        {treatment.regimens.map((regimen) => (
                          <li>
                            <a href={`/regimens/${regimen.data.id}`}>
                              {regimen.data.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p>No regimens are currently listed.</p>
                    )
                  }
                </div>
              ))
            }
          </section>
        )
      }

{
  supportiveCareItems.length > 0 && (
    <section aria-labelledby="supportive-care-heading">
      <h2 id="supportive-care-heading">Supportive Care</h2>

      <ul>
        {
          supportiveCareItems.map((item) => (
            <li>
              <a href={`/supportive-care/${item.data.id}`}>
                {item.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  )
}

      <section aria-labelledby="references-heading">
        <h2 id="references-heading">References</h2>

        {
          references.length > 0 ? (
            <ul>
              {
                references.map((source) => (
                  <li>
                    <a href={`/sources/${source.data.id}`}>
                      {source.data.publication.citation}
                    </a>
                  </li>
                ))
              }
            </ul>
          ) : (
            <p>No references are currently listed.</p>
          )
        }
      </section>
    </main>
  </body>
</html>