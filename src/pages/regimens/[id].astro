---
import Layout from "@/layouts/Layout.astro";
import { antiemeticProtocols } from "@/data/antiemetics";
import RegimenHeader from "@/components/regimens/RegimenHeader.astro";
import RegimenIndications from "@/components/regimens/RegimenIndications.astro";
import RegimenSchedule from "@/components/regimens/RegimenSchedule.astro";
import RegimenMedicationCard from "@/components/regimens/RegimenMedicationCard.astro";
import RegimenPreTreatmentAssessment from "@/components/regimens/RegimenPreTreatmentAssessment.astro";
import RegimenTreatmentPreparation from "@/components/regimens/RegimenTreatmentPreparation.astro";
import RegimenSupportiveCare from "@/components/regimens/RegimenSupportiveCare.astro";
import RegimenMonitoring from "@/components/regimens/RegimenMonitoring.astro";
import RegimenDoseModifications from "@/components/regimens/RegimenDoseModifications.astro";
import RegimenReferences from "@/components/regimens/RegimenReferences.astro";
import { getCollection } from 'astro:content';
import {
  getDrugById,
  getSourceById,
  getSupportiveCareById,
  getDiseaseById,
  getDoseModificationsByRegimen,
} from "@/utils/content";

export async function getStaticPaths() {
  const regimens = await getCollection('regimens');



  return regimens.map((regimen) => ({
    params: { id: regimen.data.id },
    props: {
      regimen,
      regimens,
    },
  }));
}

const { regimen, regimens } = Astro.props;
const antiemeticProtocol =
  antiemeticProtocols[
    regimen.data.treatmentPreparation.antiemeticRisk
  ];

  const antiemeticRecommendations = (
  await Promise.all(
    antiemeticProtocol.recommendations.map(async (recommendation) => {
      const drug = await getDrugById(recommendation.drug);

      if (!drug) {
        return undefined;
      }

      return {
        drug,
        recommendation,
      };
    }),
  )
).filter(
  (
    item,
  ): item is {
    drug: NonNullable<Awaited<ReturnType<typeof getDrugById>>>;
    recommendation: (typeof antiemeticProtocol.recommendations)[number];
  } => item !== undefined,
);
const components =
  regimen.data.type === 'composite'
    ? regimen.data.components
        .map((component) => ({
          component,
          regimen: regimens.find(
            (item) => item.data.id === component.regimen,
          ),
        }))
        .filter(
          (
            item,
          ): item is {
            component: (typeof regimen.data.components)[number];
            regimen: (typeof regimens)[number];
          } => item.regimen !== undefined,
        )
    : [];


    const standaloneMedications =
  regimen.data.type === "standalone"
    ? regimen.data.medications
    : [];

const medications = await Promise.all(
  [
    ...new Set(
      standaloneMedications.map(
        (medication) => medication.drug,
      ),
    ),
  ].map(async (drugId) => {
    const drug = await getDrugById(drugId);

    if (!drug) {
      return null;
    }

    const medication = {
      rules: standaloneMedications
        .filter(
          (item) => item.drug === drugId,
        )
        .flatMap(
          (item) => item.rules,
        ),
    };

    return {
      drug,
      medication,
    };
  }),
);

const resolvedMedications = medications.filter(
  (
    item,
  ): item is NonNullable<typeof item> =>
    item !== null,
);


const supportiveCareItems = (
  await Promise.all(
    regimen.data.supportiveCare.map((id) => getSupportiveCareById(id)),
  )
  ).filter(
  (item): item is NonNullable<typeof item> =>
    item !== undefined,
);

const diseases = (
  await Promise.all(regimen.data.diseases.map((id) => getDiseaseById(id)))
  ).filter(
  (disease): disease is NonNullable<typeof disease> =>
    disease !== undefined,
);

const references = (
  await Promise.all(regimen.data.references.map((id) => getSourceById(id)))
  ).filter(
  (source): source is NonNullable<typeof source> =>
    source !== undefined,
);

const doseModifications =
  await getDoseModificationsByRegimen(
    regimen.data.id,
  );
---


<Layout
  title={regimen.data.title}
  description={regimen.data.description}
>

  <article class="regimen-page">
    <RegimenHeader regimen={regimen} />
    <RegimenIndications diseases={diseases} />

   <!-- Composite Components -->

    {
      regimen.data.type === "composite" && (
        <section
          class="clinical-card"
          aria-labelledby="components-heading"
        >
          <div class="section-heading">
            <h2 id="components-heading">Components</h2>
            <p>
              Treatment phases that make up this regimen.
            </p>
          </div>
    
          {
            components.length > 0 ? (
              <div class="component-list">
                {components.map(
                  ({ component, regimen: componentRegimen }, index) => (
                    <article class="component-card">
                      <div class="component-card__number">
                        {index + 1}
                      </div>
    
                      <div class="component-card__main">
                        <a
                          class="component-card__title"
                          href={`/regimens/${componentRegimen.data.id}`}
                        >
                          {componentRegimen.data.title}
                        </a>
    
                        {
                          component.notes && (
                            <p class="component-card__notes">
                              {component.notes}
                            </p>
                          )
                        }
                      </div>
    
                      {
                        component.cycleRange && (
                          <div class="component-card__cycles">
                            <span class="component-card__cycles-label">
                              Cycles
                            </span>
                            <strong>
                              {component.cycleRange.start}–
                              {component.cycleRange.end}
                            </strong>
                          </div>
                        )
                      }
                    </article>
                  ),
                )}
              </div>
            ) : (
              <p class="empty-state">
                No components are currently listed.
              </p>
            )
          }
        </section>
      )
    }


{
  regimen.data.type === "standalone" && (
    <RegimenSchedule schedule={regimen.data.schedule} />
  )
}
        
        
{
  regimen.data.type === "standalone" && (
    <section
      aria-labelledby="medications-heading"
      class="clinical-card"
    >
      <div class="section-heading">
        <h2 id="medications-heading">Medications</h2>
        <p>
          Drugs, doses, administration routes, and treatment timing.
        </p>
      </div>

      {
        resolvedMedications.length > 0 ? (
          <div class="medications-list">
            {resolvedMedications.map(({ drug, medication }) => (
              <RegimenMedicationCard
                drug={drug}
                medication={medication}
              />
            ))}
          </div>
        ) : (
          <p>No medications are currently listed.</p>
        )
      }
    </section>
  )
}



{
  regimen.data.type === "standalone" && (
    <RegimenPreTreatmentAssessment
      assessment={regimen.data.preTreatmentAssessment}
    />
  )
}


{
  regimen.data.type === 'standalone' && (
    <RegimenTreatmentPreparation
      preparation={regimen.data.treatmentPreparation}
      antiemeticProtocol={antiemeticProtocol}
      antiemeticRecommendations={antiemeticRecommendations}
    />
  )
}


{
  regimen.data.type === "standalone" && (
    <RegimenSupportiveCare
      items={supportiveCareItems}
    />
  )
}


{
  regimen.data.type === "standalone" && (
    <RegimenMonitoring
      monitoring={regimen.data.monitoring}
    />
  )
}


{
  regimen.data.type === "standalone" &&
  doseModifications.length > 0 && (
    <RegimenDoseModifications
      doseModifications={doseModifications}
    />
  )
}


<RegimenReferences
  references={references}
/>
  </article>
</Layout>

<style>
  .regimen-page {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ------------------------------------------------------------------------ */
/* Composite Components                                                     */
/* ------------------------------------------------------------------------ */

.component-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.component-card {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: start;
  gap: 1rem;

  padding: 1rem;

  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);

  background: var(--color-background);
}

.component-card__number {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 1.75rem;
  height: 1.75rem;

  border-radius: 50%;

  background: var(--color-surface);
  border: 1px solid var(--color-border);

  color: var(--color-text-muted);
  font-size: 0.8rem;
  font-weight: 700;
}

.component-card__main {
  min-width: 0;
}

.component-card__title {
  display: inline-block;

  color: var(--color-text);

  font-size: 1rem;
  font-weight: 700;
}

.component-card__title:hover {
  color: var(--color-primary);
}


.component-card__notes {
  margin: 0.4rem 0 0;

  color: var(--color-text-muted);

  font-size: 0.85rem;
}

.component-card__cycles {
  display: flex;
  flex-direction: column;
  align-items: flex-end;

  padding: 0.35rem 0.65rem;

  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);

  background: var(--color-surface);

  white-space: nowrap;
}

.component-card__cycles-label {
  color: var(--color-text-muted);

  font-size: 0.7rem;
  font-weight: 600;
}

.component-card__cycles strong {
  font-size: 0.9rem;
}
  /* ------------------------------------------------------------------------ */
  /* Regimen Page — UI Foundation                                             */
  /* ------------------------------------------------------------------------ */

  .clinical-card {
    margin-top: 1.25rem;
    padding: 1.5rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);

    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .section-heading {
    margin-bottom: 1.25rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .section-heading p {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* ------------------------------------------------------------------------ */
  /* Page spacing                                                             */
  /* ------------------------------------------------------------------------ */

  .regimen-header + .clinical-card {
    margin-top: 0;
  }

  /* ------------------------------------------------------------------------ */
  /* Responsive                                                               */
  /* ------------------------------------------------------------------------ */

  @media (max-width: 600px) {
  .component-card {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .component-card__cycles {
    grid-column: 2;
    align-items: flex-start;
    justify-self: start;
  }
}
</style>

