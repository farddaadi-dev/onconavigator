---
import { getCollection } from 'astro:content';
import { formatLabel } from '@/utils/formatText';
import {
  getDrugById,
  getSourceById,
  getSupportiveCareById,
  getDiseaseById,
} from '@/utils/content';

export async function getStaticPaths() {
  const regimens = await getCollection('regimens');



  return regimens.map((regimen) => ({
    params: { id: regimen.data.id },
    props: {
      regimen,
      regimens,
    },
  }));
}

const { regimen, regimens } = Astro.props;
const components =
  regimen.data.type === 'composite'
    ? regimen.data.components
        .map((component) => ({
          component,
          regimen: regimens.find(
            (item) => item.data.id === component.regimen,
          ),
        }))
        .filter(
          (
            item,
          ): item is {
            component: (typeof regimen.data.components)[number];
            regimen: (typeof regimens)[number];
          } => item.regimen !== undefined,
        )
    : [];


    type ResolvedMedication = {
  drug: NonNullable<Awaited<ReturnType<typeof getDrugById>>>;
  medication: Extract<
    typeof regimen.data,
    { type: 'standalone' }
  >['medications'][number];
};

const medications =
  regimen.data.type === 'standalone'
    ? (
        await Promise.all(
          regimen.data.medications.map(async (medication) => {
            const drug = await getDrugById(medication.drug);

            if (!drug) {
              return undefined;
            }

            return {
              drug,
              medication,
            };
          }),
        )
      ).filter(
        (item): item is ResolvedMedication => item !== undefined,
      )
    : [];

const antiemetics = (
  await Promise.all(
    regimen.data.treatmentPreparation.antiemetics.medications.map(
      async (antiemetic) => {
        const drug = await getDrugById(antiemetic.drug);

        if (!drug) {
          return undefined;
        }

        return {
          drug,
          antiemetic,
        };
      },
    ),
  )
).filter(
  (
    item,
  ): item is {
    drug: NonNullable<Awaited<ReturnType<typeof getDrugById>>>;
    antiemetic: (typeof regimen.data.treatmentPreparation.antiemetics.medications)[number];
  } => item !== undefined,
);

const supportiveCareItems = (
  await Promise.all(
    regimen.data.supportiveCare.map((id) => getSupportiveCareById(id)),
  )
  ).filter(
  (item): item is NonNullable<typeof item> =>
    item !== undefined,
);

const diseases = (
  await Promise.all(regimen.data.diseases.map((id) => getDiseaseById(id)))
  ).filter(
  (disease): disease is NonNullable<typeof disease> =>
    disease !== undefined,
);

const references = (
  await Promise.all(regimen.data.references.map((id) => getSourceById(id)))
  ).filter(
  (source): source is NonNullable<typeof source> =>
    source !== undefined,
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{regimen.data.title} | OncoNavigator</title>
  </head>

  <body>
    <main>
      <a href="/">OncoNavigator</a>

      <header>
        <h1>{regimen.data.title}</h1>

<p>{regimen.data.description}</p>

<p>
  <strong>Setting:</strong>
  {regimen.data.setting
    .map((setting) => formatLabel(setting))
    .join(' / ')}
</p>

<p>
  <strong>Treatment intent:</strong>
  {regimen.data.treatmentIntent
    .map((intent) => formatLabel(intent))
    .join(' / ')}
</p>

        <p>
          <strong>Line of therapy:</strong>
          {regimen.data.lineOfTherapy
            .map((line) => formatLabel(line))
            .join(' / ')}
        </p>
      </header>

      <section aria-labelledby="diseases-heading">
        <h2 id="diseases-heading">Indications</h2>

        <ul>
          {
            diseases.map((disease) => (
              <li>
                <a href={`/diseases/${disease.data.id}`}>
                  {disease.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {
        regimen.data.type === 'composite' && (
          <section aria-labelledby="components-heading">
            <h2 id="components-heading">Components</h2>
      
            {
              components.length > 0 ? (
                <ol>
                  {
                    components.map(({ component, regimen: componentRegimen }) => (
                      <li>
                        <a href={`/regimens/${componentRegimen.data.id}`}>
                          {componentRegimen.data.title}
                        </a>
      
                        {
                          component.cycleRange && (
                            <span>
                              {' — '}
                              Cycles {component.cycleRange.start}–
                              {component.cycleRange.end}
                            </span>
                          )
                        }
      
                        {
                          component.notes && (
                            <p>{component.notes}</p>
                          )
                        }
                      </li>
                    ))
                  }
                </ol>
              ) : (
                <p>No components are currently listed.</p>
              )
            }
          </section>
        )
      }

{
  regimen.data.type === 'standalone' && (
    <section aria-labelledby="schedule-heading">
      <h2 id="schedule-heading">Schedule</h2>

      {
        regimen.data.schedule.cycle && (
          <p>
            <strong>Cycle length:</strong>
            {regimen.data.schedule.cycle.length.value}{' '}
            {regimen.data.schedule.cycle.length.unit}
          </p>
        )
      }

      {
        regimen.data.schedule.stopCondition.plannedCycles && (
          <p>
            <strong>Planned cycles:</strong>
            {regimen.data.schedule.stopCondition.plannedCycles}
          </p>
        )
      }
    </section>
  )
}
      {
        regimen.data.type === 'standalone' && (
          <>
      <section aria-labelledby="medications-heading">
        <h2 id="medications-heading">Medications</h2>
      
        {
          medications.length > 0 ? (
            <div>
              {
                medications.map(({ drug, medication }) => (
                  <article>
                    <h3>
                      <a href={`/drugs/${drug.data.id}`}>
                        {drug.data.title}
                      </a>
                    </h3>
      
                    {
                      medication.rules.map((rule) => {
                        const administration = rule.administration;
                        const days = administration.administrationDays;
      
                        const cycleRange = rule.condition?.cycleRange;
      
                        const hasAdministrationDetails = Boolean(
  administration.notes ||
    medication.preparationNotes ||
    medication.infusionNotes ||
    medication.comments ||
    rule.notes,
);
      
                        return (
                          <div>
                            <p>
                              <strong>
                                {rule.dose.value} {rule.dose.unit}
                              </strong>{' '}
                              {administration.route}
      
                              {administration.volume &&
                                ` in ${administration.volume.value} ${administration.volume.unit}`}
      
                              {administration.diluent &&
                                ` ${administration.diluent}`}
      
                              {administration.infusionDuration &&
                                ` over ${administration.infusionDuration}`}
      
                              {' — '}
                              Day{days.length > 1 ? 's' : ''}{' '}
                              {days.join(', ')}
      
                              {cycleRange &&
                                ` · Cycles ${cycleRange.start}–${cycleRange.end}`}
                            </p>
      
                            {
                              hasAdministrationDetails && (
                                <details>
                                  <summary>Administration details</summary>
      
                                  {administration.notes && (
                                    <p>{administration.notes}</p>
                                  )}
      
                                  {medication.preparationNotes && (
                                    <p>
                                      <strong>Preparation:</strong>{' '}
                                      {medication.preparationNotes}
                                    </p>
                                  )}
      
                                  {medication.infusionNotes && (
                                    <p>
                                      <strong>Infusion:</strong>{' '}
                                      {medication.infusionNotes}
                                    </p>
                                  )}
      
                                  {medication.comments && (
                                    <p>
                                      <strong>Notes:</strong>{' '}
                                      {medication.comments}
                                    </p>
                                  )}
      
                                  {rule.notes && (
                                    <p>
                                      <strong>Notes:</strong>{' '}
                                      {rule.notes}
                                    </p>
                                  )}
                                </details>
                              )
                            }
                          </div>
                        );
                      })
                    }
                  </article>
                ))
              }
            </div>
          ) : (
            <p>No medications are currently listed.</p>
          )
        }
      </section>

      <section aria-labelledby="assessment-heading">
        <h2 id="assessment-heading">Pre-treatment Assessment</h2>
      
        {
          regimen.data.preTreatmentAssessment.diagnosis.length > 0 && (
            <div>
              <h3>Diagnosis</h3>
              <ul>
                {regimen.data.preTreatmentAssessment.diagnosis.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      
        {
          regimen.data.preTreatmentAssessment.clinical.length > 0 && (
            <div>
              <h3>Clinical</h3>
              <ul>
                {regimen.data.preTreatmentAssessment.clinical.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      
        {
          regimen.data.preTreatmentAssessment.laboratory.length > 0 && (
            <div>
              <h3>Laboratory</h3>
              <ul>
                {regimen.data.preTreatmentAssessment.laboratory.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      
        {
          regimen.data.preTreatmentAssessment.infectionScreening.length > 0 && (
            <div>
              <h3>Infection Screening</h3>
              <ul>
                {regimen.data.preTreatmentAssessment.infectionScreening.map(
                  (item) => (
                    <li>{item}</li>
                  ),
                )}
              </ul>
            </div>
          )
        }
      
        {
          regimen.data.preTreatmentAssessment.imaging.length > 0 && (
            <div>
              <h3>Imaging</h3>
              <ul>
                {regimen.data.preTreatmentAssessment.imaging.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      
        {
          regimen.data.preTreatmentAssessment.calculations.length > 0 && (
            <div>
              <h3>Calculations</h3>
              <ul>
                {regimen.data.preTreatmentAssessment.calculations.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      
        {
          regimen.data.preTreatmentAssessment.counselling.length > 0 && (
            <div>
              <h3>Counselling</h3>
              <ul>
                {regimen.data.preTreatmentAssessment.counselling.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      </section>

      <section aria-labelledby="preparation-heading">
        <h2 id="preparation-heading">Treatment Preparation</h2>

        {
          regimen.data.treatmentPreparation.premedications.length > 0 && (
            <div>
              <h3>Premedications</h3>

              <ul>
                {regimen.data.treatmentPreparation.premedications.map(
                  (item) => (
                    <li>{item}</li>
                  ),
                )}
              </ul>
            </div>
          )
        }

{
  antiemetics.length > 0 && (
    <div>
      <h3>Antiemetics</h3>

      <p>
        <strong>Emetogenic risk:</strong>{' '}
        {formatLabel(
          regimen.data.treatmentPreparation.antiemetics.risk,
        )}
      </p>

      <ul>
        {antiemetics.map(({ drug, antiemetic }) => (
          <li>
            <strong>
              <a href={`/drugs/${drug.data.id}`}>
                {drug.data.title}
              </a>
            </strong>
            {' — '}
            {antiemetic.dose.value} {antiemetic.dose.unit}{' '}
{formatLabel(antiemetic.administration.route)}

            {
              antiemetic.administration.timing && (
                <>
                  {' — '}
                  {antiemetic.administration.timing}
                </>
              )
            }

            {
              antiemetic.administration.notes && (
                <div>
                  {antiemetic.administration.notes}
                </div>
              )
            }
          </li>
        ))}
      </ul>
    </div>
  )
}

        {
          regimen.data.treatmentPreparation.hydration.length > 0 && (
            <div>
              <h3>Hydration</h3>

              <ul>
                {regimen.data.treatmentPreparation.hydration.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          regimen.data.treatmentPreparation.prophylaxis.length > 0 && (
            <div>
              <h3>Prophylaxis</h3>

              <ul>
                {regimen.data.treatmentPreparation.prophylaxis.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      </section>

      
      
      <section aria-labelledby="supportive-care-heading">
        <h2 id="supportive-care-heading">Supportive Care</h2>
      
        {
          supportiveCareItems.length > 0 ? (
            <ul>
              {supportiveCareItems.map((item) => (
                <li>
                  <a href={`/supportive-care/${item.data.id}`}>
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p>No supportive care information is currently listed.</p>
          )
        }
      </section>
      
      <section aria-labelledby="monitoring-heading">
        <h2 id="monitoring-heading">Monitoring</h2>
      
        {
          regimen.data.monitoring.beforeEachCycle.length > 0 && (
            <div>
              <h3>Before Each Cycle</h3>
              <ul>
                {regimen.data.monitoring.beforeEachCycle.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      
        {
          regimen.data.monitoring.duringTreatment.length > 0 && (
            <div>
              <h3>During Treatment</h3>
              <ul>
                {regimen.data.monitoring.duringTreatment.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      </section>
      
      <section aria-labelledby="dose-modifications-heading">
        <h2 id="dose-modifications-heading">Dose Modifications</h2>
      
        {
          regimen.data.doseModifications.length > 0 ? (
            <ul>
              {regimen.data.doseModifications.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <p>No dose modification information is currently listed.</p>
          )
        }
      </section>
      </>
  )
}    
      <section aria-labelledby="references-heading">
        <h2 id="references-heading">References</h2>
      
        {
          references.length > 0 ? (
            <ul>
              {references.map((source) => (
                <li>
                  <a href={`/sources/${source.data.id}`}>
                    {source.data.publication.citation}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p>No references are currently listed.</p>
          )
        }
      </section>
    </main>
  </body>
</html>